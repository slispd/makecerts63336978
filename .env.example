# Banco de dados (criado automaticamente pela integração Neon na Vercel)
DATABASE_URL=postgres://usuario:senha@host.neon.tech/neondb?sslmode=require

# Segredo das sessões — gere com: openssl rand -base64 32
AUTH_SECRET=

# Administrador pré-definido (login por e-mail e senha)
ADMIN_EMAIL=admin@abix.com.br
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NAME=Administrador

# Microsoft 365 / Entra ID (opcional — sem estas variáveis o botão Microsoft não aparece)
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=

# true = qualquer conta do tenant pode entrar como coordenador
# false (padrão) = só e-mails cadastrados em "Usuários"
ALLOW_ALL_TENANT_USERS=false
